# Normalize line endings: LF in the repo, native in the working tree.
* text=auto

# Source
*.cs      text diff=csharp
*.vb      text
*.fs      text
*.razor   text
*.cshtml  text
*.js      text
*.ts      text
*.json    text
*.md      text diff=markdown
*.yml     text
*.yaml    text
*.sql     text
*.sh      text eol=lf
*.ps1     text eol=crlf
*.cmd     text eol=crlf
*.bat     text eol=crlf

# Visual Studio / MSBuild files - VS rewrites these with CRLF, so pin them
*.sln       text eol=crlf merge=union
*.slnx      text eol=crlf
*.csproj    text eol=crlf
*.vbproj    text eol=crlf
*.fsproj    text eol=crlf
*.props     text eol=crlf
*.targets   text eol=crlf
.editorconfig text eol=crlf

# Binary - never diff or eol-convert
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.pdf     binary
*.zip     binary
*.gz      binary
*.7z      binary
*.dll     binary
*.exe     binary
*.pdb     binary
*.snk     binary
*.pfx     binary
*.woff    binary
*.woff2   binary
*.ttf     binary
